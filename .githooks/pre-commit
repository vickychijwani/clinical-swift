#!/bin/sh
set -eu

sh scripts/check_architecture.sh --staged

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

[ -z "$files" ] && exit 0

echo "Running swift-format on staged Swift files..."

printf '%s\n' "$files" | xargs xcrun swift-format format --in-place
printf '%s\n' "$files" | xargs git add

